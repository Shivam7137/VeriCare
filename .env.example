# Fictional local development database only; do not reuse this password elsewhere.
DATABASE_URL=postgresql://prc:prc_local_only@127.0.0.1:55439/prc
API_HOST=127.0.0.1
API_PORT=4100
API_URL=http://127.0.0.1:4100
# Explicit opt-in for synthetic, unauthenticated local fixture endpoints.
ENABLE_SYNTHETIC_DEMO=true
# Optional exact HTTPS web origin for a temporary fictional public demo; no trailing slash.
PUBLIC_DEMO_ORIGIN=
# Hosted server-only alternative to ignored .env.sessions.json; never use NEXT_PUBLIC_ for tokens.
DEMO_SESSIONS_JSON=

# Phone simulator works without provider credentials. Keys alone never enable calls.
VOICE_MODE=simulated
VOICE_LIVE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
# Optional alias for environments that reserve OPENAI_* secret variable names.
VOICE_OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_VOICE_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE=cedar
# Department allowed to monitor unverified incoming demo calls.
VOICE_DEPARTMENT_ID=demo-department
# Public app origin included in requested text messages; no path.
SMS_APP_URL=
# Public HTTPS origin only, without a path; required only for live tests.
VOICE_PUBLIC_BASE_URL=
# Comma-separated E.164 numbers, or * to allow all numbers (codes requested for protected actions).
VOICE_ALLOWED_NUMBERS=
