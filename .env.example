# Fictional local development database only; do not reuse this password elsewhere.
DATABASE_URL=postgresql://prc:prc_local_only@127.0.0.1:55439/prc
API_HOST=127.0.0.1
API_PORT=4100
API_URL=http://127.0.0.1:4100
# Synthetic demo mode: local fixtures, fictional web sessions and the 12345678 SMS fallback.
ENABLE_SYNTHETIC_DEMO=true
# Optional exact HTTPS web origin for a temporary fictional public demo; no trailing slash.
PUBLIC_DEMO_ORIGIN=
# true lets the scheduling agent offer the earliest open slot once a request is verified.
# Staff approval and patient confirmation are still required. Restart the API after changing.
AGENT_AUTO_PROPOSE=false
# Hosted server-only alternative to ignored .env.sessions.json; never use NEXT_PUBLIC_ for tokens.
DEMO_SESSIONS_JSON=

# Phone simulator works without provider credentials. Keys alone never enable calls.
VOICE_MODE=simulated
VOICE_LIVE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
# Optional alias for environments that reserve OPENAI_* secret variable names.
VOICE_OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_VOICE_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE=gleam
VOICE_SCENARIO=emergency_contact
# Private registered contact for the fictional patient-location scenario.
DEMO_EMERGENCY_CONTACT_NAME=
DEMO_EMERGENCY_CONTACT_RELATIONSHIP=
DEMO_EMERGENCY_CONTACT_PHONE=
# Department allowed to monitor unverified incoming demo calls.
VOICE_DEPARTMENT_ID=demo-department
# Public app origin included in requested text messages; no path.
SMS_APP_URL=
# Public HTTPS origin only, without a path; required only for live tests.
VOICE_PUBLIC_BASE_URL=
# Comma-separated E.164 numbers, or * to allow all numbers (codes requested for protected actions).
VOICE_ALLOWED_NUMBERS=

# VeriCare Journey. true lets a language model plan each Visit Agent wake, using
# OPENAI_API_KEY (or VISIT_AGENT_OPENAI_API_KEY). Unset or false runs the rules path.
VISIT_AGENT_ENABLED=false
# Defaults to OPENAI_VOICE_BACKEND_MODEL.
VISIT_AGENT_MODEL=
# true adds embedding search to knowledge-base retrieval. Lexical search always runs.
KB_EMBEDDINGS=false
KB_EMBEDDING_MODEL=text-embedding-3-small
# true sends journey updates as real texts through the phone line configured above,
# only to VOICE_ALLOWED_NUMBERS. Otherwise texts are shown on screen as simulated.
JOURNEY_SMS_ENABLED=false
# Optional E.164 number for the demo patient, so her texts reach a real phone.
TWIN_PATIENT_PHONE=
