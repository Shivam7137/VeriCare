{
  "name": "patient-request-coordination",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"npm run dev -w @prc/api\" \"npm run dev -w @prc/web\" \"npm run worker\"",
    "build": "npm run build -w @prc/contracts && npm run build -w @prc/api && npm run build -w @prc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test packages/contracts/test/*.test.ts apps/api/test/*.test.ts",
    "test:integration": "tsx --test apps/api/test/integration/*.test.ts",
    "test:backend": "node --env-file=.env --import tsx --test apps/api/test/integration/*.test.ts",
    "worker": "tsx --env-file=.env apps/api/src/worker.ts",
    "worker:once": "npm run worker -- --once",
    "demo:credentials": "tsx --env-file=.env apps/api/src/demo-credentials.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "tsx --env-file=.env apps/api/src/migrate.ts",
    "db:seed": "tsx --env-file=.env apps/api/src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
